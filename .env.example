# ═══════════════════════════════════════════════════════
# FINAULT PLATFORM — Environment Configuration
# ═══════════════════════════════════════════════════════
# Copy to .env and fill in your values.
# For Cloudflare Workers, set secrets via: wrangler secret put <KEY>
# ═══════════════════════════════════════════════════════

# ── Supabase (Required) ─────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Stripe (Required for billing) ────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ── Blockchain Anchoring (Optional — enables dual-chain proof) ──
ANCHOR_PRIVATE_KEY=0x...
ANCHOR_NETWORK=base-mainnet
ANCHOR_MODE=DUAL
ALCHEMY_API_KEY=...

# ── Arweave Permanent Storage (Optional — enables permanent anchoring) ──
ARWEAVE_GATEWAY_URL=https://arweave.net
ARWEAVE_KEY_JSON={"kty":"RSA",...}

# ── Python Verifier Service ──────────────────────────
VERIFIER_URL=https://verify.finault.com

# ── ERP Integration Keys (Set per tenant) ────────────
# QB_CLIENT_ID=...
# QB_CLIENT_SECRET=...
# NETSUITE_ACCOUNT_ID=...
# XERO_CLIENT_ID=...

# ── Email (For Close Pack delivery) ──────────────────
# SENDGRID_API_KEY=SG...
# FROM_EMAIL=closepacks@finault.com
