# Finault Gateway - Environment Secrets Template
# ============================================================================
# This file serves as a template for required secrets.
# Use `wrangler secret put` to set these values in your environment.
#
# Example usage:
#   wrangler secret put SUPABASE_URL
#   wrangler secret put SUPABASE_SERVICE_KEY
#   etc.
# ============================================================================

# Supabase Configuration
SUPABASE_URL=<set-via-wrangler-secret-put>
SUPABASE_SERVICE_KEY=<set-via-wrangler-secret-put>

# LLM API Keys
OPENAI_API_KEY=<set-via-wrangler-secret-put>
ANTHROPIC_API_KEY=<set-via-wrangler-secret-put>
GOOGLE_AI_KEY=<set-via-wrangler-secret-put>
AZURE_API_KEY=<set-via-wrangler-secret-put>

# Payment Processing
STRIPE_SECRET_KEY=<set-via-wrangler-secret-put>

# Blockchain Anchoring
ANCHOR_PRIVATE_KEY=<set-via-wrangler-secret-put>

# Application Settings
ERP_LIVE_MODE=false
ANCHOR_MODE=SOFT

# Optional: Azure OpenAI (if using AZURE_API_KEY)
# AZURE_OPENAI_ENDPOINT=<set-via-wrangler-secret-put>

# Optional: Blockchain RPC Endpoints (if using ANCHOR_PRIVATE_KEY)
# ANCHOR_RPC_URL=<set-via-wrangler-secret-put>
# ANCHOR_RPC_URL_MAINNET=<set-via-wrangler-secret-put>
# ANCHOR_RPC_URL_POLYGON=<set-via-wrangler-secret-put>

# Optional: QuickBooks ERP Integration
# QB_CLIENT_ID=<set-via-wrangler-secret-put>
# QB_CLIENT_SECRET=<set-via-wrangler-secret-put>
# QB_REFRESH_TOKEN=<set-via-wrangler-secret-put>
# QB_REALM_ID=<set-via-wrangler-secret-put>

# Optional: NetSuite ERP Integration
# NS_ACCOUNT_ID=<set-via-wrangler-secret-put>
# NS_CONSUMER_KEY=<set-via-wrangler-secret-put>
# NS_CONSUMER_SECRET=<set-via-wrangler-secret-put>
# NS_TOKEN_ID=<set-via-wrangler-secret-put>
# NS_TOKEN_SECRET=<set-via-wrangler-secret-put>

# Optional: Xero ERP Integration
# XERO_CLIENT_ID=<set-via-wrangler-secret-put>
# XERO_CLIENT_SECRET=<set-via-wrangler-secret-put>
# XERO_REFRESH_TOKEN=<set-via-wrangler-secret-put>
# XERO_TENANT_ID=<set-via-wrangler-secret-put>

# Optional: Email & Notifications
# RESEND_API_KEY=<set-via-wrangler-secret-put>
# SENDGRID_API_KEY=<set-via-wrangler-secret-put>
