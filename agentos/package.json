{
  "name": "finault-agentos",
  "version": "1.0.0",
  "description": "Finault AgentOS - The Apple of AI Cost Governance",
  "type": "module",
  "main": "api/server.js",
  "scripts": {
    "start": "node api/server.js",
    "dev": "node --watch api/server.js",
    "mcp": "node mcp/finault-mcp-server.js",
    "compound": "node -e \"import('./agents/compound-learning.js').then(m => new m.default('system').nightlyCompound())\"",
    "test": "node --test",
    "lint": "eslint .",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js"
  },
  "keywords": [
    "ai",
    "cost-management",
    "finops",
    "agents",
    "mcp",
    "anthropic",
    "openai"
  ],
  "author": "Finault",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@hono/node-server": "^1.13.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@supabase/supabase-js": "^2.93.3",
    "dotenv": "^16.4.0",
    "hono": "^4.11.7",
    "jsonwebtoken": "^9.0.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/finault/agentos"
  }
}
