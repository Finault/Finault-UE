{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "core/**/*.ts",
    "pdf/**/*.ts",
    "artifacts/**/*.ts",
    "zip/**/*.ts",
    "api/**/*.ts",
    "util/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
