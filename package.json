{
  "name": "finault-platform",
  "version": "4.2.0",
  "description": "Finault — The Economic Proof Layer for AI. Sealed receipts connecting cost, revenue, and margin with cryptographic proof.",
  "private": true,
  "type": "commonjs",
  "workspaces": [
    "apps/gateway",
    "apps/close-pack",
    "apps/verifier-service"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "build": "node scripts/build.js",
    "deploy": "node scripts/deploy-all.js",
    "deploy:gateway": "npm run build && wrangler deploy",
    "deploy:pages": "wrangler pages deploy static --project-name finault",
    "deploy:verifier": "cd apps/verifier-service && flyctl deploy",
    "test": "vitest",
    "test:fcs": "node tests/fcs/fcs-threshold.test.js",
    "test:smoke": "node tests/smoke.test.js",
    "deploy:verify": "node scripts/deployment-verify.js",
    "deploy:smoke": "node scripts/smoke-test.js",
    "lint": "eslint apps/ --ext .ts,.tsx,.js",
    "lint:fix": "eslint apps/ --ext .ts,.tsx,.js --fix",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "db:migrate": "node scripts/migrate.js",
    "db:reset": "node scripts/db-reset.js",
    "clean": "rm -rf dist/ .wrangler/",
    "preflight": "npm run lint && npm run test && npm run build",
    "deploy:preflight": "node scripts/deploy-preflight.js",
    "deploy:secrets": "bash scripts/setup-secrets.sh",
    "verifier:start": "cd apps/verifier-service && python api_server_v2.py",
    "postinstall": "npm run audit || echo 'Install complete with warnings'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@supabase/supabase-js": "^2.95.3",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "stripe": "^14.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "pg": "^8.18.0",
    "typescript": "^5.5.0",
    "vitest": "^1.0.0",
    "wrangler": "^3.80.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "finops",
    "ai-economics",
    "sealed-receipts",
    "cloudflare-workers",
    "financial-infrastructure"
  ],
  "author": "Finault LLC",
  "license": "UNLICENSED"
}
