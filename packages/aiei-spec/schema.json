{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AIEI Envelope",
  "description": "Atomic Immutable Event Infrastructure (AIEI) - Portable sealed record of an AI execution event",
  "type": "object",
  "version": "1.0.0",
  "required": [
    "seal_id",
    "seal_hash",
    "sequence",
    "timestamp",
    "provider",
    "model",
    "cost_usd"
  ],
  "properties": {
    "seal_id": {
      "type": "string",
      "description": "Unique identifier for this sealed record (UUID or custom format)",
      "minLength": 1,
      "maxLength": 255
    },
    "seal_hash": {
      "type": "string",
      "description": "SHA-256 hash of seal contents (hex-encoded, 64 chars)",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sequence": {
      "type": "integer",
      "description": "Monotonically increasing sequence number in chain",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp when seal was created",
      "format": "date-time"
    },
    "provider": {
      "type": "string",
      "description": "AI provider (openai, anthropic, google, meta, mistral, custom, etc.)",
      "enum": [
        "openai",
        "anthropic",
        "google",
        "meta",
        "mistral",
        "cohere",
        "azure",
        "custom"
      ]
    },
    "model": {
      "type": "string",
      "description": "Model identifier (gpt-4o, claude-3-opus, gemini-pro, etc.)",
      "minLength": 1,
      "maxLength": 255
    },
    "cost_usd": {
      "type": "number",
      "description": "Estimated or actual cost in USD for this execution",
      "minimum": 0
    },
    "prev_hash": {
      "type": "string",
      "description": "SHA-256 hash of previous seal in chain (hex-encoded)",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tokens_in": {
      "type": "integer",
      "description": "Input tokens consumed by the model",
      "minimum": 0
    },
    "tokens_out": {
      "type": "integer",
      "description": "Output tokens generated by the model",
      "minimum": 0
    },
    "customer_id": {
      "type": "string",
      "description": "Customer or end-user identifier",
      "minLength": 1,
      "maxLength": 255
    },
    "margin": {
      "type": "number",
      "description": "Margin or revenue associated with this execution",
      "minimum": 0
    },
    "quality_score": {
      "type": "number",
      "description": "Quality metric (0-1 scale) or categorical label",
      "minimum": 0,
      "maximum": 1
    },
    "trace_id": {
      "type": "string",
      "description": "Identifier for multi-seal trace context",
      "minLength": 1,
      "maxLength": 255
    },
    "parent_seal_id": {
      "type": "string",
      "description": "ID of parent seal in hierarchical trace",
      "minLength": 1,
      "maxLength": 255
    },
    "cost_method": {
      "type": "string",
      "description": "How cost was determined (estimated, metered, callback, fixed)",
      "enum": [
        "estimated",
        "metered",
        "callback",
        "fixed"
      ]
    },
    "authorization": {
      "type": "object",
      "description": "Authorization context for this execution",
      "properties": {
        "org_id": {
          "type": "string",
          "description": "Organization identifier"
        },
        "user_id": {
          "type": "string",
          "description": "User identifier"
        },
        "api_key_prefix": {
          "type": "string",
          "description": "First 8 characters of API key for audit trail"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata key-value pairs",
      "additionalProperties": true
    }
  },
  "examples": [
    {
      "seal_id": "seal_123abc",
      "seal_hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "sequence": 1,
      "timestamp": "2026-03-20T12:30:45.123Z",
      "provider": "openai",
      "model": "gpt-4o",
      "cost_usd": 0.015,
      "tokens_in": 150,
      "tokens_out": 75,
      "customer_id": "cust_abc123",
      "margin": 0.005,
      "quality_score": 0.92,
      "trace_id": "trace_xyz",
      "parent_seal_id": null,
      "cost_method": "metered",
      "authorization": {
        "org_id": "org_finault",
        "user_id": "user_123",
        "api_key_prefix": "fk_live_1"
      }
    }
  ]
}
