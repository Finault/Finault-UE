# Cloudflare Pages Redirects Configuration for Finault
# https://developers.cloudflare.com/pages/platform/redirects/

# Route API requests to api.finault.ai
/api/* https://api.finault.ai/api/:splat 301

# /gw/* is proxied via Pages Function (functions/gw/[[path]].js)

# /audit serves audit.html (shared results viewer, renders #d=base64 data)
# The actual upload tool is in /app (the dashboard)

# Auth convenience redirects
/signup /login 301
/register /login 301
/sign-up /login 301

# Redirect dead and premature pages to homepage
# Dead: never had real content
